<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="franka_gripper">
    
    <xacro:macro name="franka_gripper_transmission" params="gripper_id:='panda'">
        
        <transmission name="${gripper_id}_finger_joint1_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${gripper_id}_finger_joint1">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            </joint>
            <actuator name="${gripper_id}_finger_joint1_motor">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

    </xacro:macro>

</robot>
