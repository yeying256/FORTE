<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="franka_gripper">
    
    <xacro:macro name="franka_gripper_gazebo" params="gripper_id:='panda'">

        <xacro:property name="link_mu1" value="100.0" />
        <xacro:property name="link_mu2" value="100.0" />
        <xacro:property name="self_collide" value="true" />

        <gazebo>
            <plugin filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so" name="${gripper_id}_mimic_joint2">
                <joint>${gripper_id}_finger_joint1</joint>
                <mimicJoint>${gripper_id}_finger_joint2</mimicJoint>
            </plugin>
        </gazebo>

        <gazebo reference="${gripper_id}_hand">
            <selfCollide>${self_collide}</selfCollide>
            <mu1>0.0</mu1>
            <mu2>0.0</mu2>
        </gazebo>
        <gazebo reference="${gripper_id}_leftfinger">
            <selfCollide>false</selfCollide>
            <mu1>${link_mu1}</mu1>
            <mu2>${link_mu2}</mu2>
            <!-- <kp>1000000.0</kp>
            <kd>1.0</kd> -->
            <minDepth>0.001</minDepth>
        </gazebo>
        <gazebo reference="${gripper_id}_rightfinger">
            <selfCollide>false</selfCollide>
            <mu1>${link_mu1}</mu1>
            <mu2>${link_mu2}</mu2>
            <!-- <kp>1000000.0</kp>
            <kd>1.0</kd> -->
            <minDepth>0.001</minDepth>
        </gazebo>

    </xacro:macro>

</robot>
