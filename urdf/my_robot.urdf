          </horizontal>
        </scan>
        <range>
          <min>0.06</min>
          <max>10.0</max>
          <!-- resolution>0.004363323</resolution -->
          <resolution>0.004359297</resolution>
          <!-- resolution>0.001</resolution -->
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_gpu_laser.so" name="moca_rear_laser_controller">
        <topicName>rear_laser/scan</topicName>
        <frameName>/moca_rear_laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
