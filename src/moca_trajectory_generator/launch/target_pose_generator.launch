<launch>
  <arg name="config_file" default="$(find moca_trajectory_generator)/config/target_pose_generator_params.yaml" />
  <arg name="force_capability_settings_file" default="$(find moca_trajectory_generator)/config/force_capability_settings.yaml" />
  <arg name="launch_vlm_mass_estimator" default="false" />
  <arg name="vlm_config_file" default="$(find moca_vlm)/config/mass_estimator_params.yaml" />
  <arg name="autostart_planning" default="true" />
  <arg name="enable_vlm_mass_request" default="$(arg launch_vlm_mass_estimator)" />
  <arg name="launch_gripper" default="no_gripper" />
  <arg name="robot_id" default="$(optenv ROBOT_ID moca_white)" />
  <arg name="world_frame" default="$(arg robot_id)_odom" />
  <arg name="franka_tool_state_topic" default="/$(arg robot_id)/franka_state_bridge/franka_tool_state" />
  <arg name="polytope_ee_frame" default="$(eval 'moca_franka_flange' if arg('launch_gripper') == 'no_gripper' else 'moca_franka_EE')" />

  <rosparam command="load" file="$(arg force_capability_settings_file)" subst_value="true" />

  <node if="$(arg launch_vlm_mass_estimator)"
        pkg="moca_vlm"
        type="mass_estimator_node.py"
        name="moca_vlm_mass_estimator"
        output="screen">
    <rosparam command="load" file="$(arg vlm_config_file)" subst_value="true" />
  </node>

  <node pkg="moca_trajectory_generator"
        type="target_pose_generator_node"
        name="target_pose_generator"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" subst_value="true" />
    <param name="autostart_planning" value="$(arg autostart_planning)" />
    <param name="enable_vlm_mass_request" value="$(arg enable_vlm_mass_request)" />
    <param name="world_frame" value="$(arg world_frame)" />
    <param name="franka_tool_state_topic" value="$(arg franka_tool_state_topic)" />
    <param name="polytope_ee_frame" value="$(arg polytope_ee_frame)" />
  </node>
</launch>
