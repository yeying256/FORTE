<launch>
  <arg name="interface_type" default="SIMULATION" />
  <arg name="robot_model" default="moca" />
  <arg name="arm_model" default="franka" />
  <arg name="arm_id" default="franka" />
  <arg name="robot_id" default="$(optenv SIM_ROBOT_ID moca_sim)" />
  <arg name="robot_brand" default="moca" />
  <arg name="arm_transmission_type" default="effort" />
  <arg name="command_output_enabled" default="true" />
  <arg name="controller_required" default="false" />
  <arg name="launch_gripper" default="no_gripper" />
  <arg name="is_floating_base_robot" default="true" />
  <arg name="robot_interface_config_file" default="$(find hrii_moca_interface)/config/moca_no_gripper.yaml" />
  <arg name="robot_arm_ip" default="$(optenv ROBOT_ARM_IP 192.168.0.101)" />

  <arg name="base_launch_robotnik_base_control" default="false" />
  <arg name="base_launch_ros_force_based_move" default="false" />
  <arg name="base_launch_ros_planar_move_plugin" default="true" />

  <arg name="launch_robot" default="true" />
  <arg name="launch_rviz" default="false" />
  <arg name="rviz_config_file" default="$(find Moca_controller)/rviz/moca_tf_tree.rviz" />
  <arg name="launch_gazebo_gui" default="true" />
  <arg name="launch_gazebo_paused" default="true" />
  <arg name="launch_gazebo_world" default="true" />
  <arg name="gazebo_world" default="$(find hrii_gazebo_utils)/worlds/attacher_world.world" />
  <arg name="launch_target_pose_generator" default="true" />
  <arg name="launch_vlm_mass_estimator" default="false" />
  <arg name="launch_planner_metrics_plotter" default="true" />
  <arg name="controller_config_file" default="$(find moca_joint_impedance_controller)/config/joint_impedance_controller_params.yaml" />
  <arg name="trajectory_config_file" default="$(find moca_trajectory_generator)/config/target_pose_generator_params.yaml" />
  <arg name="force_capability_settings_file" default="$(find moca_trajectory_generator)/config/force_capability_settings.yaml" />
  <arg name="planner_metrics_plotter_config_file" default="$(find polytope_ros)/config/planner_metrics_plotter.yaml" />
  <arg name="planner_ee_frame" default="$(eval 'moca_franka_flange' if arg('launch_gripper') == 'no_gripper' else 'moca_franka_EE')" />

  <rosparam command="load" file="$(arg force_capability_settings_file)" subst_value="true" />

  <include if="$(arg launch_robot)"
           file="$(find hrii_general_robot_controllers)/launch/generic_robot_launcher.xml"
           pass_all_args="true" />

  <include if="$(arg launch_rviz)"
           file="$(find Moca_controller)/launch/moca_rviz_only.launch">
    <arg name="robot_id" value="$(arg robot_id)" />
    <arg name="rviz_config_file" value="$(arg rviz_config_file)" />
  </include>

  <group ns="$(arg robot_id)">
    <node pkg="moca_joint_impedance_controller"
          type="moca_joint_impedance_controller_node"
          name="wb_joint_imp_controller"
          output="screen"
          required="$(arg controller_required)">
      <rosparam command="load" file="$(arg controller_config_file)" subst_value="true" />
      <param name="interface_type" value="$(arg interface_type)" />
      <param name="robot_interface_config_file" value="$(arg robot_interface_config_file)" />
      <param name="arm_transmission_type" value="$(arg arm_transmission_type)" />
      <param name="command_output_enabled" value="$(arg command_output_enabled)" />
      <param name="world_frame" value="$(arg robot_id)_odom" />
      <param name="ee_frame" value="$(arg planner_ee_frame)" />

      <remap from="~vir_torque" to="/wb_cart_imp_controller/vir_torque" />
      <remap from="~manipulability" to="/wb_cart_imp_controller/manipulability" />
      <remap from="~manipulability_ellipsoid" to="/wb_cart_imp_controller/manipulability_ellipsoid" />
      <remap from="~manipulability_gradient_norm" to="/wb_cart_imp_controller/manipulability_gradient_norm" />
      <remap from="~directional_force_capacity" to="/wb_cart_imp_controller/directional_force_capacity" />
      <remap from="~force_polytope_vertices" to="/wb_cart_imp_controller/force_polytope_vertices" />
      <remap from="~desired_force" to="/wb_cart_imp_controller/desired_force" />
      <remap from="~nullspace_task_acceleration_norm" to="/wb_cart_imp_controller/nullspace_task_acceleration_norm" />
      <remap from="~nullspace_base_arrow" to="/wb_cart_imp_controller/nullspace_base_arrow" />
      <remap from="~base_cmd_velocity_arrow" to="/wb_cart_imp_controller/base_cmd_velocity_arrow" />
      <remap from="~moca_state" to="/wb_cart_imp_controller/moca_state" />
      <remap from="~arm_task_torque" to="/wb_cart_imp_controller/arm_task_torque" />
      <remap from="~arm_nullspace_torque" to="/wb_cart_imp_controller/arm_nullspace_torque" />
      <remap from="~moca_pose" to="/wb_cart_imp_controller/moca_pose" />
      <remap from="~moca_pose_target" to="/wb_cart_imp_controller/moca_pose_target" />
      <remap from="~nullspace_task_acceleration" to="/wb_cart_imp_controller/nullspace_task_acceleration" />
      <remap from="~moca_velocity" to="/wb_cart_imp_controller/moca_velocity" />
      <remap from="~base_cmd_velocity" to="/wb_cart_imp_controller/base_cmd_velocity" />
      <remap from="~moca_state_target" to="/wb_cart_imp_controller/moca_state_target" />
    </node>
  </group>

  <node if="$(arg launch_target_pose_generator)"
        pkg="moca_trajectory_generator"
        type="target_pose_generator_node"
        name="target_pose_generator"
        output="screen">
    <rosparam command="load" file="$(arg trajectory_config_file)" subst_value="true" />
    <param name="enable_vlm_mass_request" value="$(arg launch_vlm_mass_estimator)" />
    <param name="world_frame" value="$(arg robot_id)_odom" />
    <param name="polytope_ee_frame" value="$(arg planner_ee_frame)" />
  </node>

  <node if="$(arg launch_planner_metrics_plotter)"
        pkg="polytope_ros"
        type="planner_metrics_plotter.py"
        name="planner_metrics_plotter"
        output="screen">
    <rosparam command="load" file="$(arg trajectory_config_file)" subst_value="true" />
    <param name="enable_vlm_mass_request" value="$(arg launch_vlm_mass_estimator)" />
    <param name="world_frame" value="$(arg robot_id)_odom" />
    <rosparam command="load" file="$(arg planner_metrics_plotter_config_file)" subst_value="true" />
  </node>
</launch>
